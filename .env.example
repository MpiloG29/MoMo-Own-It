# Copy to .env and run. These defaults are a working local demo — no MoMo
# credentials, no network. Only change something if the note says to.
#
#   cp .env.example .env

# ---- runtime ----
NODE_ENV=development
PORT=8090
LOG_LEVEL=info

# ---- database ----
# Matches docker-compose.yml. If you already run Postgres on 5432, publish the
# container on another port (see "Run it" in the README) and change it here too.
DATABASE_URL=postgres://momo:momo@localhost:5432/momo_own_it

# ---- momo open api ----
# 'mock' runs the whole engine without network or credentials. 'live' hits the
# MoMo sandbox and requires every MOMO_* key below.
MOMO_PROVIDER=mock
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
# The MoMo sandbox only settles EUR.
MOMO_CURRENCY=EUR
MOMO_CALLBACK_URL=

# Left blank on purpose: MOMO_PROVIDER=mock does not read them.
# Fill in from `npm run provision:sandbox` before switching to live.
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=

MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=

# ---- unlock codes (Take It Now / pay-as-you-go) ----
# Development value. Replace before any real deployment: every per-plan device
# key is derived from this.
UNLOCK_HMAC_SECRET=dev-only-secret-replace-me
UNLOCK_CODE_DIGITS=9
UNLOCK_DAYS_PER_PERIOD=7

# ---- billing clock ----
# 20 means one "week" takes twenty seconds, so a plan completes inside a demo.
# A real deployment uses 604800 (one week).
BILLING_PERIOD_SECONDS=20
# Must be true or the engine never collects anything on its own.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000

# ---- sandbox provisioning helper (npm run provision:sandbox) ----
MOMO_PROVIDER_CALLBACK_HOST=
